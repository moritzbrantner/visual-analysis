{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["lint", "build", "test:unit"],
    "full": ["format:check", "lint", "build", "test:unit"]
  },
  "requiredCapabilities": ["lint", "build", "test:unit"],
  "optionalCapabilities": ["format:check"],
  "capabilityCommands": {
    "@moritzbrantner/visual-analysis-workspace": {
      "format:check": ["cargo", "fmt", "--all", "--", "--check"],
      "lint": ["cargo", "clippy", "--locked", "--workspace", "--all-targets", "--", "-D", "warnings"],
      "build": ["cargo", "build", "--locked", "--workspace"],
      "test:unit": ["cargo", "test", "--locked", "--workspace"]
    }
  }
}
