{
  "name": "@moritzbrantner/vision-core-app",
  "version": "0.1.0",
  "description": "React app for vision-core shared visual contracts.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
