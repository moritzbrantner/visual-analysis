  },
  "dependencies": {
    "@moritzbrantner/visual-app-ui": "workspace:*",
    "@moritzbrantner/vision-core-wasm": "workspace:*",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.2"
  }
}
